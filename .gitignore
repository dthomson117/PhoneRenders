# --- Blender ---------------------------------------------------------------
# Auto-saved backup files Blender writes next to the main .blend.
*.blend1
*.blend2
*.blend@

# Blender autosave / temp output
*.tmp
*.bak

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Renders ---------------------------------------------------------------
# The committed sample set under renders/ (default_ios__* and
# default_android__* PNGs/SVGs) lives in-tree so the README has something
# to show. Personal renders just go alongside them - they show up as
# untracked and only get committed if you explicitly `git add` them.

# --- Local-only artefacts --------------------------------------------------
# Optional per-user override - drop a `render_settings.local.json` next to
# `render_settings.json` and point RENDER_SETTINGS at it.
render_settings.local.json

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
