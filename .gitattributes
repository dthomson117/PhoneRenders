# --- Git LFS ---------------------------------------------------------------
# Large binary asset files are stored via Git LFS to keep the repo lean.
*.blend  filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.hdr    filter=lfs diff=lfs merge=lfs -text

# --- Line endings ----------------------------------------------------------
# Normalize text files to LF inside the repo, let git check out the platform
# native line endings on Windows so editors don't fight us.
* text=auto eol=lf

# Windows-only scripts should stay CRLF on disk.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Explicitly binary so git doesn't try to diff / normalize them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
